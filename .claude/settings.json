{
  "hooks": {
    "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
      {
        "type": "command",
        "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce_uv.py\""
      }
      ]
    }
    ],
    "PostToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
      {
        "type": "command",
        "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-lint-format.py\""
      }
      ]
    }
    ]
  }
}