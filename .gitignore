# Python project .gitignore

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Virtual environment (recreatable via uv sync)
.venv/
.uv/

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local data
data/
!data/.gitkeep

# IDE
.idea/
.vscode/settings.json

# OS
.DS_Store
Thumbs.db

# temporary files
cookies.txt