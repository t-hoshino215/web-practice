# Python project .gitignore

# Secrets
.env
.env.*
!.env.example

# Backend (Python)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
.uv/

# Frontend (Node.js)
node_modules/
.pnpm-store/

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local data
data/
!data/.gitkeep
.tmp/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# temporary files
cookies.txt
